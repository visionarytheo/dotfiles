@import "theme.rasi"

configuration {
    show-icons: true;
}

* {
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 380px;
    location: center;
    anchor: center;
    border-radius: 12px;
    background-color: #282828;
    border: 2px;
    border-color: #504945;
    padding: 18px;
}

mainbox {
    background-color: transparent;
    children: [ "inputbar", "listview" ];
    spacing: 12px;
}

inputbar {
    background-color: #3c3836;
    border-radius: 8px;
    padding: 8px 12px;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: #fabd2f;
    margin: 0px 8px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: #ebdbb2;
    placeholder: "Search themes...";
    placeholder-color: #928374;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 5;
    spacing: 8px;
    cycle: true;
    dynamic: true;
}

element {
    background-color: #3c3836;
    text-color: #ebdbb2;
    orientation: horizontal;
    border-radius: 8px;
    padding: 8px 12px;
    spacing: 12px;
}

element selected {
    background-color: #504945;
    text-color: #fabd2f;
    border: 2px;
    border-color: #fabd2f;
}

element-icon {
    background-color: transparent;
    size: 36px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
