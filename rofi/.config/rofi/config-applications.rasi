@import "theme.rasi"

configuration {
    show-icons: true;
}

* {
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 450px;
    location: center;
    anchor: center;
    border-radius: 8px;
    background-color: @bg;
    border: 2px;
    border-color: @border-col;
    padding: 18px;
}

mainbox {
    background-color: transparent;
    children: [ "inputbar", "listview" ];
    spacing: 16px;
}

inputbar {
    background-color: @bg-hover;
    border-radius: 25px;
    padding: 8px 12px;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    margin: 0px 8px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search Applications";
    placeholder-color: @fg-alt;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 6;
    spacing: 6px;
    cycle: true;
    dynamic: true;
    flow: vertical;
}

element {
    background-color: transparent;
    text-color: @fg;
    orientation: horizontal;
    border-radius: 25px;
    padding: 10px;
    spacing: 8px;
}

element selected {
    background-color: @bg-hover;
    text-color: @accent;
}

element-icon {
    background-color: transparent;
    size: 30px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.0;
    vertical-align: 0.5;
    margin: 4px 0px 0px 0px;
}
